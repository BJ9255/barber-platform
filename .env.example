# Connect to Supabase via connection pooling with Supavisor.
# Try this for deployment.
POSTGRES_PRISMA_URL="postgresql://postgres.example:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations.
POSTGRES_URL_NON_POOLING="postgresql://postgres.example:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Build time
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# Mot de passe de l'espace coiffeur (/admin)
ADMIN_PASSWORD="choisis-un-mot-de-passe-long"
