# Copie ce fichier en .env puis remplis les valeurs.

# Connexion à la base PostgreSQL (utilisée par Prisma)
POSTGRES_URL="postgresql://utilisateur:motdepasse@hote:5432/base"

# Mot de passe de l'espace coiffeur (/admin)
ADMIN_PASSWORD="choisis-un-mot-de-passe-long"

# Facultatif : secret de signature des sessions.
# Par défaut, il est dérivé de ADMIN_PASSWORD (changer le mot de passe déconnecte tout le monde).
# ADMIN_SESSION_SECRET="une-longue-chaine-aleatoire"

# Notifications push (facultatif). Génère une paire de clés avec : npx web-push generate-vapid-keys
# La clé publique est envoyée au navigateur (d'où NEXT_PUBLIC_), la clé privée reste sur le serveur.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="cle-publique"
VAPID_PRIVATE_KEY="cle-privee"
VAPID_SUBJECT="mailto:ton-adresse@exemple.fr"

# Protège la tâche planifiée des rappels (/api/cron/reminders). Vercel l'envoie tout seul à chaque exécution.
CRON_SECRET="une-longue-chaine-aleatoire"
