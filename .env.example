# Copie ce fichier en .env puis remplis les valeurs.

# Connexion à la base PostgreSQL (utilisée par Prisma)
POSTGRES_URL="postgresql://utilisateur:motdepasse@hote:5432/base"

# Mot de passe de l'espace coiffeur (/admin)
ADMIN_PASSWORD="choisis-un-mot-de-passe-long"

# Facultatif : secret de signature des sessions.
# Par défaut, il est dérivé de ADMIN_PASSWORD (changer le mot de passe déconnecte tout le monde).
# ADMIN_SESSION_SECRET="une-longue-chaine-aleatoire"
